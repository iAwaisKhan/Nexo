NODE_ENV=development
API_PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nexo
# Generate a unique secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
CLIENT_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
LOG_LEVEL=info
